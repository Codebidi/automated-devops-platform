# =============================================================================
# DeployHub – CI/CD Platform | Root .env.example
# Copy to .env and fill in real values before running docker compose or python run.py.
#
# IMPORTANT: Generate secrets with hex output (no special characters like @ / : ? #)
# so they never break DATABASE_URL:
#   openssl rand -hex 24
# =============================================================================

# =============================================================================
# REQUIRED FOR REAL MODE (USE_MOCK=false)
# =============================================================================

# PostgreSQL password for the 'deployhub' user (use hex, avoid @ : / ?)
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24

# JWT signing key – must be >= 32 chars, never reuse this placeholder
SECRET_KEY=change-me-openssl-rand-hex-24-for-secret-key

# HMAC secret for GitHub Actions deployment webhook (must match GitHub secret WEBHOOK_SECRET)
WEBHOOK_SECRET=change-me-openssl-rand-hex-24-webhook

# Mode: true = mock data (demo/dev), false = live GitHub Actions integration
USE_MOCK=false

# GitHub Actions integration (required when USE_MOCK=false)
GITHUB_TOKEN=ghp_yourRealPersonalAccessTokenHere
GITHUB_OWNER=your-github-org
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main

# Initial admin seed account (used once on first startup when users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeStrongAdmin123

# =============================================================================
# OPTIONAL (recommended for full AWS / health / automation support)
# =============================================================================

# X-API-Key for automation (e.g. rollback CI job). Leave empty to disable.
API_KEY=

# Workflow filenames in the target repository's .github/workflows/
GITHUB_WORKFLOW_FILE=deploy.yml
ROLLBACK_WORKFLOW_FILE=rollback.yml

# AWS & Infrastructure
AWS_REGION=us-east-1
# ECR_REGISTRY is optional (e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com).
# If unset, image_uri stays null until learned from a deployment webhook.
ECR_REGISTRY=
# ECR_REPOSITORY must be a repository NAME only (e.g. my-app), NOT a full URI.
ECR_REPOSITORY=my-app
EC2_HOST=
APP_PORT=5000
# Include the port if your app does not run on 80/443
APP_HEALTH_URL=http://localhost:5000/health

# CORS (comma-separated list of allowed frontend origins)
# Docker frontend is port 8080; Vite dev server is port 5173
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Frontend demo banner (set to true only for mock/demo presentations)
VITE_SHOW_DEMO=false

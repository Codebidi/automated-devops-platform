# =============================================================================
# DeployHub – CI/CD Platform  |  Root .env.example
# Copy to .env and fill in real values before running docker compose.
# Generate secrets with:  openssl rand -hex 24
# (hex output avoids special chars that can break DATABASE_URL)
# =============================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# Password for the deployhub PostgreSQL user.
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24

# ── Application Secrets ────────────────────────────────────────────────────
# JWT signing key – must be >= 32 chars, never reuse the example value.
SECRET_KEY=change-me-openssl-rand-hex-24-for-secret-key

# X-API-Key for automation (e.g. rollback CI job). Leave empty to disable.
API_KEY=change-me-openssl-rand-hex-24-api-key

# HMAC secret for GitHub Actions deployment webhook.
WEBHOOK_SECRET=change-me-openssl-rand-hex-24-webhook

# ── Admin seed account (used once on first startup in real mode) ───────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePassword123

# ── Mode ───────────────────────────────────────────────────────────────────
# true  = mock data, no GitHub required (demo / dev)
# false = live GitHub Actions integration
USE_MOCK=false

# ── GitHub Actions (required when USE_MOCK=false) ──────────────────────────
GITHUB_TOKEN=ghp_exampleTokenWithRepoAndWorkflowScope12345
GITHUB_OWNER=your-github-org
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main
GITHUB_WORKFLOW_FILE=deploy.yml
ROLLBACK_WORKFLOW_FILE=rollback.yml

# ── AWS & Infrastructure ───────────────────────────────────────────────────
AWS_REGION=us-east-1
ECR_REPOSITORY=123456789012.dkr.ecr.us-east-1.amazonaws.com/your-app
EC2_HOST=ec2-xx-xx-xx-xx.compute-1.amazonaws.com
APP_HEALTH_URL=http://localhost:8080/health

# ── CORS (comma-separated list of allowed frontend origins) ───────────────
CORS_ORIGINS=http://localhost:8080

# ── Frontend ───────────────────────────────────────────────────────────────
# Set to true to show demo banner in the UI
VITE_SHOW_DEMO=false

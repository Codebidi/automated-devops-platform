# Mode: true for zero-setup mock mode, false for live GitHub Actions
USE_MOCK=true

# GitHub Actions Integration (Required when USE_MOCK=false)
GITHUB_TOKEN=ghp_exampleTokenWithRepoAndWorkflowScope12345
GITHUB_OWNER=codebidi
GITHUB_REPO=ai-devops-platform
GITHUB_BRANCH=main
GITHUB_WORKFLOW_FILE=deploy.yml
ROLLBACK_WORKFLOW_FILE=rollback.yml

# AWS & Infrastructure Deployment Targets
AWS_REGION=us-east-1
ECR_REPOSITORY=123456789012.dkr.ecr.us-east-1.amazonaws.com/codebidi-platform
EC2_HOST=ec2-54-210-92-14.compute-1.amazonaws.com
APP_HEALTH_URL=http://localhost:8080/health

# Security & Secrets (SECRET_KEY must be >= 32 characters and changed from default in production)
SECRET_KEY=change-this-to-a-very-secure-random-32-char-key-production
API_KEY=devops-automation-secret-key-prod-9876543210
WEBHOOK_SECRET=github-actions-deployment-webhook-secret-xyz123
TOKEN_TTL_HOURS=8

# Initial Admin Credentials (used on initial DB seed in real mode)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345SecurePassword

# Networking & Database
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=data/cicd.db
CACHE_TTL_SECONDS=10
PORT=8000
